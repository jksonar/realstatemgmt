# Copy this file to .env.docker and adjust as needed, then run:
#   docker compose --env-file .env.docker up --build

SECRET_KEY=change-me-to-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Must match the db service's POSTGRES_* values in docker-compose.yml
DB_ENGINE=django.db.backends.postgresql
DB_NAME=realstatemgmt
DB_USER=realstatemgmt
DB_PASSWORD=realstatemgmt
DB_HOST=db
DB_PORT=5432

EMAIL_HOST_USER=test@example.com
EMAIL_HOST_PASSWORD=password
